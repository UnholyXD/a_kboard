{
    "manufacturer": "unholyxd",
    "keyboard_name": "AK_Board",
    "maintainer": "unholyxd",
    "bootloader": "atmel-dfu",
    "diode_direction": "COL2ROW", 
    "features": {
        "bootmagic": true, 
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true
    },
    "matrix_pins": {
        "cols": ["D1", "D0", "D4", "C6", "D7"],
        "rows": ["E6", "B4", "B5"]
    },
    "processor": "atmega32u4",
    "usb": {
        "device_version": "0.0.1",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "encoder": {
        "rotary": [
            {"pin_a": "F5", "pin_b": "F4"}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout":[
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [0, 4], "x": 4, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
